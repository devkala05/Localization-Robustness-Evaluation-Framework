<launch>

    <arg name="project" default="lvi_sam"/>
    <arg name="use_compressed_image_republish" default="false"/>
    <arg name="run_visual" default="true"/>
    <arg name="lidar_param_file" default="$(find lvi_sam)/config/params_lidar.yaml"/>
    <arg name="vins_param_file" default="$(find lvi_sam)/config/params_camera.yaml"/>

    <!-- Lidar odometry params.  Callers can override this file so wrapper
         configs are not overwritten by the package's baked-in defaults. -->
    <rosparam file="$(arg lidar_param_file)" command="load" />

    <!-- VINS config. Loaded only when visual nodes are requested. -->
    <param if="$(arg run_visual)" name="vins_config_file" type="string" value="$(arg vins_param_file)" />
    
    <!-- Lidar odometry -->
    <node pkg="$(arg project)" type="$(arg project)_imuPreintegration" name="$(arg project)_imuPreintegration" output="screen" respawn="false"/>
    <node pkg="$(arg project)" type="$(arg project)_imageProjection" name="$(arg project)_imageProjection" output="screen" respawn="false"/>
    <node pkg="$(arg project)" type="$(arg project)_featureExtraction" name="$(arg project)_featureExtraction" output="screen" respawn="false"/>
    <node pkg="$(arg project)" type="$(arg project)_mapOptmization" name="$(arg project)_mapOptmization" output="screen" respawn="false"/>

    <!-- Optional visual feature and odometry. The UrbanNav wrapper now enables
         this with a dataset-specific ZED2 right-camera calibration. Loop closure
         remains controlled by the VINS config file. -->
    <group if="$(arg run_visual)">
      <node pkg="$(arg project)" type="$(arg project)_visual_feature" name="$(arg project)_visual_feature" output="screen" respawn="false"/>
      <node pkg="$(arg project)" type="$(arg project)_visual_odometry" name="$(arg project)_visual_odometry" output="screen" respawn="false"/>
      <node pkg="$(arg project)" type="$(arg project)_visual_loop" name="$(arg project)_visual_loop" output="screen" respawn="false"/>

      <node if="$(arg use_compressed_image_republish)" pkg="image_transport" type="republish" name="$(arg project)_republish" args="compressed in:=/camera/image_raw raw out:=/camera/image_raw" output="screen" respawn="false"/>
    </group>

</launch>
