<launch>

    <arg name="use_lvisam_rviz" default="false"/>

    <!--- Robot State TF -->
    <include file="$(find lvi_sam)/launch/include/module_robot_state_publisher.launch" />

    <!--- Run Rviz-->
    <include if="$(arg use_lvisam_rviz)" file="$(find lvi_sam)/launch/include/module_rviz.launch" />

    <!--- SAM -->
    <include file="$(find lvi_sam)/launch/include/module_sam.launch" />

</launch>
