CameraTrajectory*.txt
kf_*.txt
trajectory*.txt
*.osa
*.voc.tmp
rtabmap.db

# Keep ORB vocabulary if intentionally tracked
# Uncomment if vocabulary is too large and should not be committed:
# ORBvoc.txt
# ORBvoc.txt.tar.gz

# =========================
# Dataset / Bags / Outputs
# =========================
*.bag
*.mcap
/outputs/
/golden/
/reports/generated/

# Allow small dataset metadata/config files to be committed if added later.
!/data/
!/data/**/
!/data/**/*.md
!/data/**/*.txt
!/data/**/*.yaml
!/data/**/*.yml
!/data/**/*.json
!/data/**/.gitkeep

# =========================
# Logs
# =========================
*.log
*.err
*.out

# =========================
# Temporary Files
# =========================
/tmp/
/temp/
/.cache/
.cache-*/
*.tmp
*.bak

# =========================
# Large ML / Model Files
# =========================
*.pt
*.pth
*.onnx
*.ckpt
*.weights
*.engine

# =========================
# Secrets / Local Config
# =========================
.env
.env.*
!.env.example
config/local.yaml
config/private.yaml
secrets/
credentials/
*.key
*.pem

# =========================
# Project Source Safety Net
# =========================
# These are intentionally allowed because this repository keeps important
# launch/config/wrapper code across several directories.
!**/*.py
!**/*.sh
!**/*.launch
!**/*.yaml
!**/*.yml
!**/*.rviz
!**/*.md
!**/*.xml
!**/*.msg
!**/Dockerfile

# Generated data/results must remain ignored even though CSV/JSON/TXT files are
# otherwise valid project assets in this repository.
/data/results/**
/data/**/*.bag
/data/**/*.mcap
!/data/results/**/.gitkeep
