# =========================
*.tar
*.tar.gz
*.tgz
*.zip
*.7z
*.rar
docker/**/build/
docker/**/.cache/
docker/**/tmp/

# =========================
# CMake / C++ Build
# =========================
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
compile_commands.json
*.o
*.a
*.so
*.so.*
*.dylib
*.dll
*.exe
*.out

