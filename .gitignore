# =========================
# ROS / Catkin
# =========================
/devel/
/devel_isolated/
/build/
/build_isolated/
/install/
/install_isolated/
/log/
/logs/
/.catkin_tools/
/catkin_generated/
/.cmake_tools/
*.bag.active

# Keep ROS/source manifests visible even inside vendored trees.
!**/CMakeLists.txt
!**/package.xml

# =========================
# ROS Runtime / RViz
# =========================
.ros/
*.rviz~
*.urdf~
*.launch~
*.yaml~

