Panels:
  - Class: rviz/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: orbslam3_map
    Frame Rate: 30
  Displays:
    - Class: rviz/Grid
      Name: Grid
      Enabled: true
      Plane: XY
      Cell Size: 1
    - Class: rviz/Path
      Name: ORB-SLAM3 Live Path
      Enabled: true
      Topic: /orbslam3/live_camera_path
      Line Style: Lines
      Line Width: 0.04
    - Class: rviz/Path
      Name: ORB-SLAM3 Loop-Closed Path
      Enabled: false
      Topic: /orbslam3/camera_path
      Line Style: Lines
      Line Width: 0.03
    - Class: rviz/Odometry
      Name: ORB-SLAM3 Odometry
      Enabled: true
      Topic: /orbslam3/camera_odometry
      Shape: Arrow
      Keep: 1000
      Position Tolerance: 0.05
      Angle Tolerance: 0.05
    - Class: rviz/PointCloud2
      Name: ORB-SLAM3 Map Points
      Enabled: true
      Topic: /orbslam3/map_points
      Queue Size: 3
      Style: Points
      Size (Pixels): 4
      Color Transformer: FlatColor
      Color: 255; 255; 255
      Alpha: 1
      Decay Time: 0
    - Class: rviz/Image
      Name: Camera
      Enabled: true
      Image Topic: /camera/right/image_raw
      Queue Size: 2
      Transport Hint: raw
  Enabled: true
  Name: root
  Tools:
    - Class: rviz/Interact
    - Class: rviz/MoveCamera
    - Class: rviz/Select
  Value: true
Window Geometry:
  Height: 900
  Width: 1440
