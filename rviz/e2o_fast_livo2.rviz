Panels:
  - Class: rviz/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: camera_init
    Frame Rate: 30
  Displays:
    - Class: rviz/Grid
      Name: Grid
      Enabled: true
      Plane: XY
      Cell Size: 1
    - Class: rviz/Path
      Name: FAST-LIVO2 Path
      Enabled: true
      Topic: /path
      Line Style: Lines
      Line Width: 0.04
    - Class: rviz/PointCloud2
      Name: Registered Cloud
      Enabled: true
      Topic: /cloud_registered
      Queue Size: 3
      Style: Points
      Size (Pixels): 3
      Color Transformer: AxisColor
      Axis: Z
      Autocompute Value Bounds: true
      Alpha: 1
      Decay Time: 0
    - Class: rviz/Image
      Name: Camera
      Enabled: true
      Image Topic: /camera/right/image_raw
      Queue Size: 2
      Transport Hint: raw
  Enabled: true
  Name: root
  Tools:
    - Class: rviz/Interact
    - Class: rviz/MoveCamera
    - Class: rviz/Select
  Value: true
Window Geometry:
  Height: 900
  Width: 1440
