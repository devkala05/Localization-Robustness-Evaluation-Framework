Panels:
  - Class: rviz/Displays
    Name: Displays
  - Class: rviz/Selection
    Name: Selection
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Displays:
    - Class: rviz/Grid
      Name: Grid
      Enabled: true
      Plane: XY
      Cell Size: 1
    - Class: rviz/TF
      Name: TF
      Enabled: true
      Frame Timeout: 15
      Show Axes: true
      Show Names: true
    - Class: rviz/Path
      Name: Fused path
      Enabled: true
      Topic: /fused_localization/path
      Line Style: Lines
      Line Width: 0.03
    - Class: rviz/PointCloud2
      Name: E2O LiDAR
      Enabled: true
      Topic: /livox/lidar
      Queue Size: 5
      Style: Points
      Size (Pixels): 2
    - Class: rviz/Image
      Name: E2O Camera
      Enabled: true
      Image Topic: /camera/right/image_raw
      Queue Size: 2
      Transport Hint: raw
  Enabled: true
  Name: root
  Tools:
    - Class: rviz/Interact
    - Class: rviz/MoveCamera
    - Class: rviz/Select
  Value: true
Window Geometry:
  Height: 900
  Width: 1440
