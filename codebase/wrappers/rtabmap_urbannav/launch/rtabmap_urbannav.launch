<launch>
  <param name="use_sim_time" value="true"/>

  <arg name="database_path" default="/data/output/rtabmap_urbannav.db"/>
  <arg name="delete_db_on_start" default="true"/>
  <arg name="input_cloud_topic" default="/cloud_registered_raw"/>
  <arg name="scan_cloud_topic" default="/rtabmap/scan_cloud"/>
  <arg name="icp_odom_topic" default="/rtabmap/icp_odom"/>
  <arg name="input_rgb_topic" default="/camera/right/image_raw"/>
  <arg name="input_camera_info_topic" default="/camera/right/camera_info"/>
  <arg name="subscribe_rgb" default="true"/>
  <arg name="benchmark_odom_topic" default="/rtabmap/odometry/mapping"/>
  <arg name="path_topic" default="/rtabmap/mapping/path"/>
  <arg name="map_frame_id" default="map"/>
  <arg name="odom_frame_id" default="camera_init"/>
  <arg name="base_frame_id" default="body"/>
  <arg name="publish_icp_tf" default="true"/>

  <!-- Sanitize raw/perturbed PointCloud2 metadata before RTAB-Map.
       Keep the incoming frame_id by default so RTAB-Map can use the static
       body->velodyne calibration instead of pretending raw LiDAR points are
       already in body coordinates. -->
  <node name="rtabmap_cloud_sanitizer"
        pkg="rtabmap_urbannav"
        type="cloud_sanitizer_node.py"
        output="screen">
    <param name="input_topic" value="$(arg input_cloud_topic)"/>
    <param name="output_topic" value="$(arg scan_cloud_topic)"/>
    <param name="frame_id" value=""/>
    <param name="drop_until_first_odom" value="false"/>
  </node>

  <!-- Standalone RTAB-Map odometry frontend.
       This replaces the old FAST-LIO2 /Odometry prior with RTAB-Map's own
       ICP odometry computed directly from scan_cloud. -->
  <node name="rtabmap_icp_odometry"
        pkg="rtabmap_odom"
        type="icp_odometry"
        output="screen">
    <param name="frame_id" value="$(arg base_frame_id)"/>
    <param name="odom_frame_id" value="$(arg odom_frame_id)"/>
    <param name="publish_tf" type="bool" value="$(arg publish_icp_tf)"/>
    <param name="subscribe_scan_cloud" type="bool" value="true"/>
    <param name="subscribe_scan" type="bool" value="false"/>
    <param name="wait_for_transform_duration" type="double" value="0.5"/>
    <param name="queue_size" type="int" value="50"/>
    <param name="approx_sync" type="bool" value="false"/>

    <!-- Conservative ICP settings for UrbanNav-style spinning LiDAR clouds. -->
    <param name="Odom/GuessMotion" value="true"/>
    <param name="Odom/ResetCountdown" value="0"/>
    <param name="Icp/PointToPlane" value="true"/>
    <param name="Icp/MaxCorrespondenceDistance" value="1.0"/>
    <param name="Icp/VoxelSize" value="0.4"/>
    <param name="Icp/DownsamplingStep" value="2"/>
    <param name="Icp/Iterations" value="30"/>
    <param name="Icp/Epsilon" value="0.001"/>
    <param name="Icp/PointToPlaneK" value="20"/>
    <param name="Icp/PointToPlaneRadius" value="0.0"/>

    <remap from="scan_cloud" to="$(arg scan_cloud_topic)"/>
    <remap from="odom" to="$(arg icp_odom_topic)"/>
  </node>

  <!-- RTAB-Map graph/map backend. It consumes odometry from
       rtabmap_icp_odometry, the LiDAR scan cloud, and the right camera image.
       Reg/Strategy=2 lets RTAB-Map use visual features together with ICP
       instead of running as a LiDAR-only graph. -->
  <node name="rtabmap"
        pkg="rtabmap_slam"
        type="rtabmap"
        output="screen"
        args="$(eval '--delete_db_on_start' if arg('delete_db_on_start') == 'true' else '')">

    <param name="database_path" value="$(arg database_path)"/>
    <param name="frame_id" value="$(arg base_frame_id)"/>
    <param name="odom_frame_id" value="$(arg odom_frame_id)"/>
    <param name="map_frame_id" value="$(arg map_frame_id)"/>
    <param name="publish_tf" type="bool" value="false"/>

    <param name="subscribe_depth" type="bool" value="false"/>
    <param name="subscribe_rgb" type="bool" value="$(arg subscribe_rgb)"/>
    <param name="subscribe_rgbd" type="bool" value="false"/>
    <param name="subscribe_scan" type="bool" value="false"/>
    <param name="subscribe_scan_cloud" type="bool" value="true"/>
    <param name="approx_sync" type="bool" value="true"/>
    <param name="wait_for_transform_duration" type="double" value="0.5"/>
    <param name="sync_queue_size" type="int" value="50"/>
    <param name="topic_queue_size" type="int" value="100"/>
    <param name="queue_size" type="int" value="100"/>
    <param name="approx_sync_max_interval" type="double" value="0.25"/>

    <param name="Reg/Strategy" value="2"/>
    <param name="Vis/FeatureType" value="6"/>
    <param name="Kp/MaxFeatures" value="1000"/>
    <param name="Kp/DetectorStrategy" value="6"/>
    <param name="RGBD/NeighborLinkRefining" value="true"/>
    <param name="RGBD/ProximityBySpace" value="true"/>
    <param name="RGBD/ProximityMaxGraphDepth" value="50"/>
    <param name="RGBD/ProximityPathMaxNeighbors" type="string" value="1"/>
    <param name="RGBD/OptimizeFromGraphEnd" value="true"/>

    <param name="Rtabmap/DetectionRate" value="2.0"/>
    <param name="Grid/Sensor" value="0"/>
    <param name="Grid/3D" value="true"/>
    <param name="Icp/PointToPlane" value="true"/>
    <param name="Icp/MaxCorrespondenceDistance" value="1.0"/>
    <param name="Icp/VoxelSize" value="0.4"/>
    <param name="Icp/DownsamplingStep" value="2"/>
    <param name="Icp/Iterations" value="30"/>
    <param name="Mem/IncrementalMemory" value="true"/>
    <param name="Mem/InitWMWithAllNodes" value="false"/>

    <remap from="odom" to="$(arg icp_odom_topic)"/>
    <remap from="scan_cloud" to="$(arg scan_cloud_topic)"/>
    <remap from="rgb/image" to="$(arg input_rgb_topic)"/>
    <remap from="rgb/camera_info" to="$(arg input_camera_info_topic)"/>
    <remap from="cloud_map" to="/rtabmap/cloud_map"/>
    <remap from="mapPath" to="/rtabmap/mapPath"/>
  </node>

  <!-- Standard benchmark odometry/path comes from RTAB-Map's optimized mapPath. -->
  <node name="rtabmap_output_adapter_node"
        pkg="rtabmap_urbannav"
        type="rtabmap_output_adapter_node.py"
        output="screen">
    <param name="input_path_topic" value="/rtabmap/mapPath"/>
    <param name="fallback_odom_topic" value="$(arg icp_odom_topic)"/>
    <param name="output_odom_topic" value="$(arg benchmark_odom_topic)"/>
    <param name="output_path_topic" value="$(arg path_topic)"/>
    <param name="child_frame_id" value="$(arg base_frame_id)"/>
  </node>
</launch>
