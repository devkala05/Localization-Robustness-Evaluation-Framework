Panels:
  - Class: rviz/Displays
    Name: Displays
  - Class: rviz/Views
    Name: Views
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 38; 38; 38
    Fixed Frame: map
    Frame Rate: 30
  Displays:
    - Class: rviz/Grid
      Name: Grid
      Enabled: true
      Plane: XY
      Cell Size: 1
      Line Style:
        Line Width: 0.03
        Value: Lines
      Color: 160; 160; 160
      Alpha: 0.5
    - Class: rviz/TF
      Name: TF
      Enabled: true
      Frame Timeout: 15
      Show Axes: true
      Show Names: false
      Marker Scale: 1
    - Class: rviz/Odometry
      Name: FLOAM Odometry
      Enabled: true
      Topic: /floam/odometry
      Shape: Arrow
      Keep: 1000
      Position Tolerance: 0.05
      Angle Tolerance: 0.05
      Color: 255; 90; 30
      Alpha: 1
    - Class: rviz/Path
      Name: FLOAM Trajectory
      Enabled: true
      Topic: /floam/path
      Line Style: Lines
      Line Width: 0.08
      Color: 80; 220; 120
      Alpha: 1
      Buffer Length: 1
    - Class: rviz/Pose
      Name: FLOAM Pose
      Enabled: true
      Topic: /pose
      Shape: Axes
      Axes Length: 1
      Axes Radius: 0.08
      Color: 255; 255; 255
      Alpha: 1
    - Class: rviz/PointCloud2
      Name: Apriori Map
      Enabled: true
      Topic: /apriori_map
      Queue Size: 2
      Style: Points
      Size (Pixels): 2
      Color Transformer: AxisColor
      Axis: Z
      Autocompute Value Bounds: true
      Alpha: 0.45
      Decay Time: 0
    - Class: rviz/PointCloud2
      Name: Filtered Features
      Enabled: true
      Topic: /velodyne_points_filtered
      Queue Size: 3
      Style: Points
      Size (Pixels): 3
      Color Transformer: AxisColor
      Axis: Z
      Autocompute Value Bounds: true
      Alpha: 1
      Decay Time: 1
    - Class: rviz/PointCloud2
      Name: Transformed Input
      Enabled: false
      Topic: /velodyne_points_transformed
      Queue Size: 3
      Style: Points
      Size (Pixels): 2
      Color Transformer: AxisColor
      Axis: Z
      Autocompute Value Bounds: true
      Alpha: 0.7
      Decay Time: 1
    - Class: rviz/PointCloud2
      Name: Edge Features
      Enabled: false
      Topic: /laser_cloud_edge
      Queue Size: 3
      Style: Points
      Size (Pixels): 3
      Color Transformer: FlatColor
      Color: 255; 70; 70
      Alpha: 1
      Decay Time: 1
    - Class: rviz/PointCloud2
      Name: Surface Features
      Enabled: false
      Topic: /laser_cloud_surf
      Queue Size: 3
      Style: Points
      Size (Pixels): 2
      Color Transformer: FlatColor
      Color: 40; 210; 255
      Alpha: 1
      Decay Time: 1
  Enabled: true
  Name: root
  Tools:
    - Class: rviz/Interact
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/SetInitialPose
      Topic: /initialpose
    - Class: rviz/Measure
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 35
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Name: Current View
      Pitch: 0.785
      Target Frame: map
      Yaw: 0.785
    Saved: ~
  Value: true
Window Geometry:
  Height: 900
  Width: 1440
