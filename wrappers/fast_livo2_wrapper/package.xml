<?xml version="1.0"?>
<package format="2">
  <name>fast_livo2_wrapper</name>
  <version>1.0.0</version>
  <description>
    Black-box testing wrapper for FAST-LIVO2 (LiDAR-IMU-Visual odometry) on
    the UrbanNav-HK dataset. Bridges rosbag sensor topics (Velodyne LiDAR,
    Xsens IMU, ZED2 right camera) into the exact topic names and frame-IDs
    expected by FAST-LIVO2 without modifying its source code. Records
    trajectory, odometry, and maps; exports results to CSV/TUM/KITTI format;
    and provides a ready-to-use RViz configuration.
  </description>

  <maintainer email="user@example.com">FAST-LIVO2 Wrapper</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>

  <build_depend>rospy</build_depend>
  <build_depend>std_msgs</build_depend>
  <build_depend>sensor_msgs</build_depend>
  <build_depend>geometry_msgs</build_depend>
  <build_depend>nav_msgs</build_depend>
  <build_depend>tf2_ros</build_depend>
  <build_depend>tf2_geometry_msgs</build_depend>
  <build_depend>message_filters</build_depend>
  <build_depend>visualization_msgs</build_depend>

  <exec_depend>rospy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>tf2_geometry_msgs</exec_depend>
  <exec_depend>message_filters</exec_depend>
  <exec_depend>pcl_ros</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>image_transport</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>

  <export>
  </export>
</package>
