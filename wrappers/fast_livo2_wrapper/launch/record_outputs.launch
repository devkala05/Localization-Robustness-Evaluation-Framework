<!-- record_outputs.launch
     Launches the output recorder node which:
       1. Subscribes to all FAST-LIVO2 output topics
       2. Writes trajectory to TUM format (.txt)
       3. Writes odometry to CSV
       4. Records all FAST-LIVO2 outputs to a rosbag for replay

     Intentionally separate so it can be started alongside or after
     FAST-LIVO2 without modifying the algorithm.
-->
<launch>
  <param name="use_sim_time" value="true"/>

  <!-- Output directory on the host (bind-mounted as /data/output) -->
  <arg name="output_dir"  default="/data/output"/>
  <arg name="bag_name"    default="fast_livo2_output.bag"/>
  <arg name="record_bag"  default="true"/>

  <!-- ══════════════════════════════════════════════════════════════════
       Output recorder node
       Subscribes: /path, /Odometry, /cloud_registered, /cloud_registered_body
       Writes:     trajectory_tum.txt, odometry.csv, fast_livo2_output.bag
       ══════════════════════════════════════════════════════════════════ -->
  <node name="output_recorder_node"
        pkg="fast_livo2_wrapper"
        type="output_recorder_node.py"
        output="screen">
    <param name="output_dir"  value="$(arg output_dir)"/>
    <param name="bag_name"    value="$(arg bag_name)"/>
    <param name="record_bag"  value="$(arg record_bag)"/>
  </node>

</launch>
