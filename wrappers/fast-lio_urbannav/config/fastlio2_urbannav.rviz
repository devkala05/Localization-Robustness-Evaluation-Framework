Panels:
  - Class: rviz/Displays
    Help Height: 0
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Registered LiDAR1
        - /Accumulated LiDAR1
        - /Localization Path1
        - /Ground Truth Path1
        - /Current Pose1
        - /Right Camera1
      Splitter Ratio: 0.55
    Tree Height: 760

Preferences:
  PromptSaveOnExit: false

Toolbars:
  toolButtonStyle: 2

Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.45
      Cell Size: 5
      Class: rviz/Grid
      Color: 120; 120; 120
      Enabled: true
      Line Style:
        Line Width: 0.029999999329447746
        Value: Lines
      Name: Grid
      Normal Cell Count: 0
      Offset:
        X: 0
        Y: 0
        Z: 0
      Plane: XY
      Plane Cell Count: 40
      Reference Frame: <Fixed Frame>
      Value: true

    - Alpha: 1
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Max Value: 30
        Min Value: -5
        Value: true
      Axis: Z
      Channel Name: intensity
      Class: rviz/PointCloud2
      Color: 255; 255; 255
      Color Transformer: Intensity
      Decay Time: 0
      Enabled: true
      Invert Rainbow: false
      Max Color: 255; 255; 255
      Max Intensity: 255
      Min Color: 0; 0; 0
      Min Intensity: 0
      Name: Registered LiDAR
      Position Transformer: XYZ
      Queue Size: 20
      Selectable: false
      Size (Pixels): 2
      Size (m): 0.019999999552965164
      Style: Points
      Topic: /cloud_registered
      Use Fixed Frame: true
      Use rainbow: true
      Value: true

    - Alpha: 0.75
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Max Value: 30
        Min Value: -5
        Value: true
      Axis: Z
      Channel Name: z
      Class: rviz/PointCloud2
      Color: 80; 220; 170
      Color Transformer: AxisColor
      Decay Time: 45
      Enabled: true
      Invert Rainbow: false
      Max Color: 255; 255; 255
      Min Color: 0; 0; 0
      Name: Accumulated LiDAR
      Position Transformer: XYZ
      Queue Size: 80
      Selectable: false
      Size (Pixels): 1
      Size (m): 0.029999999329447746
      Style: Points
      Topic: /cloud_registered
      Use Fixed Frame: true
      Use rainbow: true
      Value: true

    - Alpha: 1
      Buffer Length: 1
      Class: rviz/Path
      Color: 20; 255; 70
      Enabled: true
      Head Arrow Shaft Diameter: 0.10000000149011612
      Head Arrow Shaft Length: 0.10000000149011612
      Head Length: 0.30000001192092896
      Head Radius: 0.10000000149011612
      Length: 0.30000001192092896
      Line Style: Lines
      Line Width: 0.07999999821186066
      Name: Localization Path
      Offset:
        X: 0
        Y: 0
        Z: 0
      Pose Color: 255; 120; 255
      Pose Style: None
      Queue Size: 20
      Radius: 0.029999999329447746
      Shaft Diameter: 0.10000000149011612
      Shaft Length: 0.10000000149011612
      Topic: /path
      Value: true

    - Alpha: 1
      Buffer Length: 1
      Class: rviz/Path
      Color: 255; 150; 20
      Enabled: true
      Head Arrow Shaft Diameter: 0.10000000149011612
      Head Arrow Shaft Length: 0.10000000149011612
      Head Length: 0.30000001192092896
      Head Radius: 0.10000000149011612
      Length: 0.30000001192092896
      Line Style: Lines
      Line Width: 0.07999999821186066
      Name: Ground Truth Path
      Offset:
        X: 0
        Y: 0
        Z: 0
      Pose Color: 255; 190; 80
      Pose Style: None
      Queue Size: 20
      Radius: 0.029999999329447746
      Shaft Diameter: 0.10000000149011612
      Shaft Length: 0.10000000149011612
      Topic: /ground_truth_path
      Value: true

    - Angle Tolerance: 0.10000000149011612
      Class: rviz/Odometry
      Covariance:
        Orientation:
          Alpha: 0.25
          Color: 255; 255; 127
          Color Style: Unique
          Frame: Local
          Offset: 1
          Scale: 1
          Value: false
        Position:
          Alpha: 0.15
          Color: 204; 51; 204
          Scale: 1
          Value: false
        Value: false
      Enabled: true
      Keep: 20
      Name: Current Pose
      Position Tolerance: 0.10000000149011612
      Queue Size: 20
      Shape:
        Alpha: 1
        Axes Length: 1
        Axes Radius: 0.10000000149011612
        Color: 255; 60; 30
        Head Length: 0.4000000059604645
        Head Radius: 0.15000000596046448
        Shaft Length: 1.2000000476837158
        Shaft Radius: 0.05000000074505806
        Value: Arrow
      Topic: /Odometry
      Value: true

    - Class: rviz/Image
      Enabled: true
      Image Topic: /camera/right/image_raw
      Max Value: 1
      Median window: 5
      Min Value: 0
      Name: Right Camera
      Normalize Range: true
      Queue Size: 2
      Transport Hint: raw
      Unreliable: false
      Value: true

  Enabled: true
  Global Options:
    Background Color: 34; 36; 38
    Default Light: true
    Fixed Frame: camera_init
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz/Interact
      Hide Inactive: false
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/FocusCamera
  Value: true
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 80
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.05999999865889549
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05000000074505806
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.009999999776482582
      Pitch: 1.0
      Target Frame: camera_init
      Yaw: 3.14
    Saved: ~

Window Geometry:
  Displays:
    collapsed: false
  Height: 900
  Hide Left Dock: false
  Hide Right Dock: false
  Right Camera:
    collapsed: false
  Width: 1500
  X: 20
  Y: 30
