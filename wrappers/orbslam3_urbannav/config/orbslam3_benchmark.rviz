Panels:
  - Class: rviz/Displays
    Help Height: 78
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /TF1
        - /Path1
        - /Odometry1
      Splitter Ratio: 0.5
    Tree Height: 755
  - Class: rviz/Selection
    Name: Selection
  - Class: rviz/Tool Properties
    Name: Tool Properties
    Splitter Ratio: 0.5886790156364441
  - Class: rviz/Views
    Name: Views
    Splitter Ratio: 0.5
  - Class: rviz/Time
    Experimental: false
    Name: Time
    SyncMode: 0
    SyncSource: ""

Preferences:
  PromptSaveOnExit: true

Visualization Manager:
  Class: ""
  Displays:

    # ── Ground plane grid ──────────────────────────────────────────────────
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz/Grid
      Color: 160; 160; 164
      Enabled: true
      Line Style:
        Line Width: 0.029999999329447746
        Value: Lines
      Name: Grid
      Normal Cell Count: 0
      Offset:
        X: 0
        Y: 0
        Z: 0
      Plane: XY
      Plane Cell Count: 50
      Reference Frame: <Fixed Frame>
      Value: true

    # ── TF frames ─────────────────────────────────────────────────────────
    - Class: rviz/TF
      Enabled: true
      Frame Timeout: 15
      Frames:
        All Enabled: true
      Marker Scale: 0.3
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Update Interval: 0
      Value: true

    # ── Camera trajectory (ORB-SLAM3 path) ────────────────────────────────
    - Alpha: 1
      Buffer Length: 1
      Class: rviz/Path
      Color: 0; 200; 255
      Enabled: true
      Head Arrow Shaft Diameter: 0.05
      Head Arrow Shaft Length: 0.05
      Head Length: 0.1
      Head Radius: 0.05
      Length: 0.1
      Line Style: Lines
      Line Width: 0.02
      Name: Camera Trajectory
      Offset:
        X: 0
        Y: 0
        Z: 0
      Pose Color: 255; 100; 0
      Pose Style: None
      Queue Size: 10
      Radius: 0.02
      Topic: /orbslam3/mapping/path
      Value: true

    # ── Current camera pose (odometry arrow) ──────────────────────────────
    - Angle Tolerance: 0.10000000149011612
      Class: rviz/Odometry
      Covariance:
        Orientation:
          Alpha: 0.5
          Color: 255; 255; 127
          Color Style: Unique
          Frame: Local
          Offset: 1
          Scale: 1
          Value: false
        Position:
          Alpha: 0.3
          Color: 204; 51; 204
          Scale: 1
          Value: false
        Value: false
      Enabled: true
      Keep: 1
      Name: Current Pose
      Position Tolerance: 0.05
      Queue Size: 10
      Shape:
        Alpha: 1
        Axes Length: 0.5
        Axes Radius: 0.05
        Color: 255; 50; 0
        Head Length: 0.2
        Head Radius: 0.07
        Shaft Length: 0.5
        Shaft Radius: 0.035
        Value: Arrow
      Topic: /orbslam3/odometry/mapping
      Value: true

    # ── Tracked map points ─────────────────────────────────────────────────
    - Alpha: 1
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Max Value: 10
        Min Value: -10
        Value: true
      Axis: Z
      Channel Name: intensity
      Class: rviz/PointCloud2
      Color: 200; 200; 50
      Color Transformer: FlatColor
      Decay Time: 0
      Enabled: true
      Invert Rainbow: false
      Max Color: 255; 255; 255
      Min Color: 0; 0; 0
      Name: Map Points
      Position Transformer: XYZ
      Queue Size: 5
      Selectable: true
      Size (Pixels): 2
      Size (m): 0.01
      Style: Points
      Topic: /orb_slam3/tracked_mappoints
      Use Fixed Frame: true
      Use rainbow: false
      Value: true

    # ── Right camera image feed ────────────────────────────────────────────
    - Class: rviz/Image
      Enabled: true
      Image Topic: /camera/image_raw
      Max Value: 1
      Median window: 5
      Min Value: 0
      Name: Right Camera
      Normalize Range: true
      Queue Size: 2
      Transport Hint: raw
      Unreliable: false
      Value: true

    # ── ORB-SLAM3 tracking debug image ────────────────────────────────────
    - Class: rviz/Image
      Enabled: true
      Image Topic: /orb_slam3/tracking_image
      Max Value: 1
      Median window: 5
      Min Value: 0
      Name: Tracking Debug
      Normalize Range: true
      Queue Size: 2
      Transport Hint: raw
      Unreliable: false
      Value: true

    # ── Tracking status text ──────────────────────────────────────────────
    - Class: rviz/MarkerArray
      Enabled: false
      Marker Topic: /visualization_marker_array
      Name: Markers
      Queue Size: 100
      Value: false



    - Alpha: 1
      Buffer Length: 1
      Class: rviz/Path
      Color: 255; 170; 0
      Enabled: true
      Head Arrow Shaft Diameter: 0.03
      Head Arrow Shaft Length: 0.03
      Head Length: 0.08
      Head Radius: 0.04
      Length: 0.1
      Line Style: Lines
      Line Width: 0.03
      Name: Ground Truth Path
      Offset:
        X: 0
        Y: 0
        Z: 0
      Pose Color: 255; 170; 0
      Pose Style: None
      Queue Size: 10
      Radius: 0.02
      Topic: /ground_truth_path
      Value: true

    - Class: rviz/Marker
      Enabled: true
      Marker Topic: /benchmark/bag_clock_marker
      Name: Bag Clock
      Queue Size: 1
      Value: true

    # ── Camera body axes ─────────────────────────────────────────────────
    - Class: rviz/Axes
      Enabled: true
      Length: 0.3
      Name: Camera Frame
      Radius: 0.05
      Reference Frame: camera_right
      Value: true

  Enabled: true
  Global Options:
    Background Color: 40; 40; 40
    Default Light: true
    Fixed Frame: camera_init
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz/Interact
      Hide Inactive: false
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/FocusCamera
    - Class: rviz/Measure
    - Class: rviz/PublishPoint
      Single click: true
      Topic: /clicked_point
  Value: true
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 20
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.06
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.01
      Pitch: 0.8
      Target Frame: camera_init
      Yaw: 2.5
    Saved: ~

Window Geometry:
  Camera Trajectory:
    collapsed: false
  Current Pose:
    collapsed: false
  Displays:
    collapsed: false
  Height: 900
  Hide Left Dock: false
  Hide Right Dock: false
  Right Camera:
    collapsed: false
  Tracking Debug:
    collapsed: false
  Width: 1600
  X: 0
  Y: 27
