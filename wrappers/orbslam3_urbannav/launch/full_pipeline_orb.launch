<launch>
  <param name="use_sim_time" value="true"/>

  <arg name="mode" default="$(optenv ORB_MODE stereo)"/>
  <arg name="world_frame_id" default="camera_init"/>
  <arg name="child_frame_id" default="camera_right"/>
  <arg name="output_odom_topic" default="/orbslam3/odometry/mapping"/>
  <arg name="output_path_topic" default="/orbslam3/mapping/path"/>

  <!-- Native ORB-SLAM3 node. Input images are produced by custom_fastlio_adapter:
       stereo: /camera/left/image_raw + /camera/right/image_raw
       mono:   /camera/image_raw -->
  <include file="$(find orbslam3_urbannav)/launch/orbslam3_urbannav.launch">
    <arg name="mode" value="$(arg mode)"/>
  </include>

  <node name="orbslam3_pose_republisher_node"
        pkg="orbslam3_urbannav"
        type="pose_republisher_node.py"
        output="screen">
    <param name="world_frame_id" value="$(arg world_frame_id)"/>
    <param name="child_frame_id" value="$(arg child_frame_id)"/>
    <param name="output_odom_topic" value="$(arg output_odom_topic)"/>
    <param name="output_path_topic" value="$(arg output_path_topic)"/>
  </node>
</launch>
