<!-- r3live_urbannav.launch
     Production UrbanNav R3LIVE wrapper.

     Default mode is stable LIO-first because upstream R3LIVE visual/spinning-LiDAR
     operation is fragile on UrbanNav. The native R3LIVE runner is started, but a
     FAST-LIO2 fallback frontend is also launched by default so the standardized
     benchmark output never remains empty if native R3LIVE publishes no odometry.
-->
<launch>
  <param name="use_sim_time" value="true"/>
  <arg name="config_path" default="$(find r3live_urbannav)/config/r3live_urbannav.yaml"/>
  <arg name="fastlio_config_path" default="$(find fast_lio_urbannav)/config/velodyne_urbannav.yaml"/>
  <arg name="run_visual" default="false"/>
  <arg name="enable_fastlio_fallback" default="true"/>
  <arg name="pcd_save_en" default="false"/>
  <arg name="pcd_path" default="/data/output/r3live_map.pcd"/>

  <rosparam command="load" file="$(arg config_path)"/>
  <param name="r3live_common/pcd_save_en" value="$(arg pcd_save_en)"/>
  <param name="r3live_common/pcd_path" value="$(arg pcd_path)"/>
  <param name="r3live_common/run_visual" value="$(arg run_visual)"/>

  <!-- Proven UrbanNav LiDAR-IMU frontend used as R3LIVE LIO-first fallback. -->
  <group if="$(arg enable_fastlio_fallback)">
    <include file="$(find fast_lio_urbannav)/launch/fast_lio2_urbannav.launch">
      <arg name="config_path" value="$(arg fastlio_config_path)"/>
    </include>
  </group>

  <!-- Native upstream R3LIVE process. Stable role tries LiDAR front-end first,
       then full mapping if the front-end binary is not present. -->
  <node name="r3live_native" pkg="r3live_urbannav" type="run_r3live_native.py" output="screen" required="false">
    <param name="role" value="stable"/>
    <param name="config_path" value="$(arg config_path)"/>
    <param name="run_visual" value="$(arg run_visual)"/>
  </node>

  <node name="r3live_trajectory_mux" pkg="r3live_urbannav" type="trajectory_mux_node.py" output="screen">
    <param name="odom_topics" value="/r3live/odometry,/Odometry,/aft_mapped_to_init,/aft_mapped_to_init_odom"/>
    <param name="output_odom_topic" value="/r3live/odometry/mapping"/>
    <param name="output_path_topic" value="/r3live/mapping/path"/>
    <param name="fixed_frame" value="camera_init"/>
    <param name="child_frame" value="body"/>
    <param name="tf_pairs" value=""/>
    <param name="use_tf_fallback" value="false"/>
    <param name="odom_stale_sec" value="0.75"/>
  </node>

  <node name="r3live_tf_broadcaster" pkg="r3live_urbannav" type="tf_broadcaster_node.py" output="screen"/>

  <node name="r3live_watchdog" pkg="r3live_urbannav" type="watchdog_node.py" output="screen">
    <param name="period" value="3.0"/>
    <param name="odom_topic" value="/r3live/odometry/mapping"/>
    <param name="lidar_topic" value="/cloud_registered_raw"/>
    <param name="camera_topic" value="/camera/image_raw"/>
  </node>
</launch>
