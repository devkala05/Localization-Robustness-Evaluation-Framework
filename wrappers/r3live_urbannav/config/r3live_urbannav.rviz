Panels:
  - Class: rviz/Displays
    Name: Displays
  - Class: rviz/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz/Grid
      Name: Grid
      Enabled: true
      Plane: XY
      Cell Size: 10
      Color: 160; 160; 160
      Alpha: 0.4
    - Class: rviz/TF
      Name: TF
      Enabled: true
      Marker Scale: 0.4
      Show Arrows: true
      Show Axes: true
      Show Names: false
    - Class: rviz/Path
      Name: Ground Truth Path
      Enabled: true
      Topic: /ground_truth_path
      Color: 255; 128; 0
      Line Style: Lines
      Line Width: 0.08
    - Class: rviz/Odometry
      Name: Ground Truth Pose
      Enabled: true
      Topic: /ground_truth_odometry
      Color: 255; 0; 0
      Shape: Arrow
      Keep: 1
      Position Tolerance: 0
      Angle Tolerance: 0
    - Class: rviz/Path
      Name: R3LIVE Native Path
      Enabled: true
      Topic: /r3live/mapping/path
      Color: 0; 255; 255
      Line Style: Lines
      Line Width: 0.10
    - Class: rviz/Path
      Name: R3LIVE Benchmark Output Path
      Enabled: true
      Topic: /r3live/path/output
      Color: 255; 255; 0
      Line Style: Lines
      Line Width: 0.08
    - Class: rviz/Odometry
      Name: R3LIVE Native Odometry
      Enabled: true
      Topic: /r3live/odometry/mapping
      Color: 0; 255; 255
      Shape: Arrow
      Keep: 10
      Position Tolerance: 0
      Angle Tolerance: 0
    - Class: rviz/Odometry
      Name: R3LIVE Benchmark Output Odom
      Enabled: true
      Topic: /r3live/odometry/output
      Color: 255; 255; 0
      Shape: Arrow
      Keep: 10
      Position Tolerance: 0
      Angle Tolerance: 0
    - Class: rviz/PointCloud2
      Name: Raw Velodyne Bag Cloud
      Enabled: true
      Topic: /velodyne_points
      Style: Points
      Size (Pixels): 3
      Size (m): 0.05
      Alpha: 0.7
      Color Transformer: Intensity
      Decay Time: 0
    - Class: rviz/PointCloud2
      Name: R3LIVE Input Cloud /livox/lidar
      Enabled: true
      Topic: /livox/lidar
      Style: Points
      Size (Pixels): 3
      Size (m): 0.05
      Alpha: 0.85
      Color Transformer: Intensity
      Decay Time: 0
    - Class: rviz/PointCloud2
      Name: R3LIVE Cloud Registered candidate
      Enabled: true
      Topic: /cloud_registered
      Style: Points
      Size (Pixels): 3
      Size (m): 0.05
      Alpha: 0.9
      Color Transformer: Intensity
      Decay Time: 5
    - Class: rviz/PointCloud2
      Name: R3LIVE Laser Surround candidate
      Enabled: true
      Topic: /laser_cloud_surround
      Style: Points
      Size (Pixels): 2
      Size (m): 0.04
      Alpha: 0.9
      Color Transformer: Intensity
      Decay Time: 5
    - Class: rviz/PointCloud2
      Name: R3LIVE RGB Map candidate
      Enabled: false
      Topic: /RGB_map
      Style: Points
      Size (Pixels): 2
      Size (m): 0.04
      Alpha: 0.9
      Color Transformer: RGB8
      Decay Time: 0
    - Class: rviz/Image
      Enabled: true
      Image Topic: /camera/image_raw
      Max Value: 1
      Median window: 5
      Min Value: 0
      Name: Mono Camera
      Normalize Range: true
      Queue Size: 2
      Transport Hint: raw
    - Class: rviz/Marker
      Name: Bag Clock
      Enabled: true
      Marker Topic: /benchmark/bag_clock_marker
  Enabled: true
  Global Options:
    Fixed Frame: camera_init
    Background Color: 48; 48; 48
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz/Interact
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/FocusCamera
    - Class: rviz/Measure
    - Class: rviz/SetInitialPose
    - Class: rviz/SetGoal
  Value: true
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 120
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Pitch: 0.785
      Yaw: 0.785
      Name: Current View
Window Geometry:
  Height: 900
  Width: 1400
  X: 40
  Y: 40
