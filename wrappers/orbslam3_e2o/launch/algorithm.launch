<launch>
  <param name="use_sim_time" value="true"/>
  <arg name="world_frame_id" default="orbslam3_map"/>
  <arg name="camera_frame_id" default="camera_color_optical_frame"/>
  <arg name="body_frame_id" default="base_link"/>
  <arg name="body_yaw_offset_deg" default="180.0"/>
  <arg name="output_odom_topic" default="/orbslam3/camera_odometry"/>
  <arg name="output_path_topic" default="/orbslam3/camera_path"/>
  <arg name="optimized_path_topic" default="/orbslam3/optimized_camera_path"/>
  <arg name="live_path_topic" default="/orbslam3/live_camera_path"/>
  <arg name="camera_config" default="$(find orbslam3_e2o)/config/e2o_front_mono_orbslam3.yaml"/>
  <arg name="executable" default="$(optenv ORB_SLAM3_EXECUTABLE RGBD)"/>
  <arg name="max_step_m" default="1.25"/>
  <arg name="max_gap_step_m" default="3.0"/>
  <arg name="max_speed_mps" default="12.0"/>
  <arg name="max_yaw_step_deg" default="45.0"/>
  <arg name="max_backtrack_m" default="0.75"/>

  <include file="$(find orbslam3_e2o)/launch/native.launch">
    <arg name="camera_config" value="$(arg camera_config)"/>
    <arg name="executable" value="$(arg executable)"/>
  </include>

  <node name="orbslam3_pose_republisher" pkg="orbslam3_e2o"
        type="pose_republisher_node.py" output="screen" required="true">
    <param name="world_frame_id" value="$(arg world_frame_id)"/>
    <param name="camera_frame_id" value="$(arg camera_frame_id)"/>
    <param name="body_frame_id" value="$(arg body_frame_id)"/>
    <param name="body_yaw_offset_deg" value="$(arg body_yaw_offset_deg)"/>
    <param name="output_odom_topic" value="$(arg output_odom_topic)"/>
    <param name="output_path_topic" value="$(arg output_path_topic)"/>
    <param name="optimized_path_topic" value="$(arg optimized_path_topic)"/>
    <param name="live_path_topic" value="$(arg live_path_topic)"/>
    <param name="raw_odom_topic" value="/orbslam3/raw_camera_odometry"/>
    <param name="raw_path_topic" value="/orbslam3/raw_camera_path"/>
    <param name="raw_map_topic" value="/orbslam3/raw_map_points"/>
    <param name="input_keyframe_path_topic" value="/orb_slam3/keyframe_path"/>
    <param name="tracking_timeout_sec" value="2.0"/>
    <param name="path_publish_period_sec" value="0.5"/>
    <param name="max_step_m" value="$(arg max_step_m)"/>
    <param name="max_gap_step_m" value="$(arg max_gap_step_m)"/>
    <param name="max_speed_mps" value="$(arg max_speed_mps)"/>
    <param name="max_yaw_step_deg" value="$(arg max_yaw_step_deg)"/>
    <param name="max_backtrack_m" value="$(arg max_backtrack_m)"/>
  </node>
</launch>
