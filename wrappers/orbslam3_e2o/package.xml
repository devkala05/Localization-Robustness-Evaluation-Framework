<?xml version="1.0"?>
<package format="2">
  <name>orbslam3_e2o</name>
  <version>1.0.0</version>
  <description>E2O-only external launch and pose adapter for the native ORB-SLAM3 RGB-D ROS executable.</description>
  <maintainer email="kitnawatayush@gmail.com">Ayush Kitnawat</maintainer>
  <license>MIT</license>
  <buildtool_depend>catkin</buildtool_depend>
  <depend>geometry_msgs</depend><depend>nav_msgs</depend><depend>rospy</depend>
  <depend>sensor_msgs</depend><depend>std_msgs</depend><depend>tf2_ros</depend>
  <exec_depend>python3-numpy</exec_depend>
</package>
