Panels:
  - Class: rviz/Displays
    Name: Displays
  - Class: rviz/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.55
      Cell Size: 20
      Class: rviz/Grid
      Color: 120; 120; 125
      Enabled: true
      Name: Grid
      Plane: XY
    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /compare_rviz/markers
      Name: Compared Trajectories And Legend
      Queue Size: 10
    - Class: rviz/Path
      Color: 25; 255; 80
      Enabled: true
      Line Style: Lines
      Line Width: 0.14
      Name: Ground Truth Path
      Topic: /compare_rviz/ground_truth/path
  Enabled: true
  Global Options:
    Background Color: 24; 24; 26
    Fixed Frame: camera_init
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz/Interact
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/FocusCamera
    - Class: rviz/Measure
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 180
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Pitch: 1.1
      Target Frame: camera_init
      Yaw: 0.8
Window Geometry:
  Height: 950
  Width: 1500
