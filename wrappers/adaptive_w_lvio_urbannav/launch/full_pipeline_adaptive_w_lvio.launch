<launch>
  <param name="use_sim_time" value="true"/>

  <arg name="launch_fastlio2" default="true"/>
  <arg name="input_odom_topic" default="/Odometry"/>
  <arg name="input_cloud_topic" default="/cloud_registered_raw"/>
  <arg name="input_camera_topic" default="/camera/right/image_raw"/>
  <arg name="input_imu_topic" default="/livox/imu"/>

  <!-- FAST-LIO2 frontend. The perturbation adapter and bag player are started
       by ./run, matching the other benchmark algorithms. -->
  <include if="$(arg launch_fastlio2)" file="$(find fast_lio_urbannav)/launch/fast_lio2_urbannav.launch"/>

  <include file="$(find adaptive_w_lvio_urbannav)/launch/adaptive_w_lvio.launch">
    <arg name="input_odom_topic" value="$(arg input_odom_topic)"/>
    <arg name="input_cloud_topic" value="$(arg input_cloud_topic)"/>
    <arg name="input_camera_topic" value="$(arg input_camera_topic)"/>
    <arg name="input_imu_topic" value="$(arg input_imu_topic)"/>
    <arg name="publish_tf" value="false"/>
  </include>
</launch>
