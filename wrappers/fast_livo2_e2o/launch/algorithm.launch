<launch>
  <!-- FAST-LIVO2 remains an unmodified black box. This launch only loads E2O
       parameters, starts the upstream executable, suppresses its authoritative
       TF, and normalizes the native odometry topic. -->
  <param name="use_sim_time" value="true"/>
  <arg name="config_path" default="$(find fast_livo2_e2o)/config/fast_livo2_e2o.yaml"/>
  <arg name="pcd_save_en" default="false"/>
  <arg name="pcd_path" default="/data/output/fast_livo2_map.pcd"/>
  <arg name="img_en" default="1"/>
  <arg name="lidar_en" default="1"/>
  <arg name="imu_en" default="true"/>
  <arg name="scan_line" default="16"/>
  <arg name="output_topic" default="/fast_livo2/odometry"/>
  <arg name="rebase_on_start" default="true"/>
  <arg name="anchor_pose_topic" default="/fused_localization/pose"/>
  <arg name="anchor_wait_sec" default="2.0"/>
  <arg name="anchor_max_age_sec" default="2.0"/>

  <rosparam command="load" file="$(arg config_path)"/>
  <param name="pcd_save/pcd_save_en" value="$(arg pcd_save_en)"/>
  <param name="pcd_save/pcd_path" value="$(arg pcd_path)"/>
  <param name="common/img_en" value="$(arg img_en)"/>
  <param name="common/lidar_en" value="$(arg lidar_en)"/>
  <param name="imu/imu_en" value="$(arg imu_en)"/>
  <param name="preprocess/scan_line" value="$(arg scan_line)"/>

  <node name="laserMapping" pkg="fast_livo" type="fastlivo_mapping"
        output="screen" required="true">
    <param name="config_path" value="$(arg config_path)"/>
    <remap from="/livox/lidar" to="/livox/lidar"/>
    <remap from="/livox/imu" to="/livox/imu"/>
    <remap from="/camera/right/image_raw" to="/camera/right/image_raw"/>
    <!-- The fused node is the only authoritative navigation TF publisher. -->
    <remap from="/tf" to="/native/fast_livo2/tf"/>
    <remap from="/tf_static" to="/native/fast_livo2/tf_static"/>
  </node>

  <node name="fastlivo2_odometry_alias" pkg="fast_livo2_e2o"
        type="odometry_alias_node.py" output="screen" required="true">
    <param name="preferred_topic" value="/Odometry"/>
    <param name="fallback_topic" value="/aft_mapped_to_init"/>
    <param name="output_topic" value="$(arg output_topic)"/>
    <param name="rebase_on_start" value="$(arg rebase_on_start)"/>
    <param name="anchor_pose_topic" value="$(arg anchor_pose_topic)"/>
    <param name="anchor_wait_sec" value="$(arg anchor_wait_sec)"/>
    <param name="anchor_max_age_sec" value="$(arg anchor_max_age_sec)"/>
  </node>
</launch>
