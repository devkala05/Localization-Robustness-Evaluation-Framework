Panels:
  - Class: rviz/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: odom
    Frame Rate: 30
  Displays:
    - Class: rviz/Grid
      Name: Grid
      Enabled: true
      Plane: XY
      Cell Size: 1
    - Class: rviz/TF
      Name: Native LVI-SAM TF
      Enabled: true
      Frame Timeout: 15
      Show Axes: true
      Show Names: false
    - Class: rviz/Odometry
      Name: LVI-SAM Odometry
      Enabled: true
      Topic: /lvisam/odometry
      Shape: Arrow
      Keep: 1000
      Position Tolerance: 0.1
      Angle Tolerance: 0.1
    - Class: rviz/Path
      Name: LVI-SAM Native Path
      Enabled: true
      Topic: /lvi_sam/lidar/mapping/path
      Line Style: Lines
      Line Width: 0.04
      Color: 25; 255; 80
    - Class: rviz/PointCloud2
      Name: LVI-SAM Registered Cloud
      Enabled: true
      Topic: /lvi_sam/lidar/mapping/cloud_registered
      Queue Size: 3
      Style: Points
      Size (Pixels): 3
      Color Transformer: AxisColor
      Axis: Z
      Autocompute Value Bounds: true
      Alpha: 1
      Decay Time: 0
    - Class: rviz/PointCloud2
      Name: LVI-SAM Local Map
      Enabled: true
      Topic: /lvi_sam/lidar/mapping/map_local
      Queue Size: 2
      Style: Points
      Size (Pixels): 2
      Color Transformer: AxisColor
      Axis: Z
      Autocompute Value Bounds: true
      Alpha: 1
      Decay Time: 0
    - Class: rviz/PointCloud2
      Name: LVI-SAM Raw Input
      Enabled: false
      Topic: /lvisam/points_raw
      Queue Size: 2
      Style: Points
      Size (Pixels): 2
      Color Transformer: AxisColor
      Axis: Z
      Autocompute Value Bounds: true
      Alpha: 0.6
      Decay Time: 1
    - Class: rviz/Image
      Name: LVI-SAM Camera
      Enabled: true
      Image Topic: /lvisam/camera/image_raw
      Queue Size: 2
      Transport Hint: raw
  Enabled: true
  Name: root
  Tools:
    - Class: rviz/Interact
    - Class: rviz/MoveCamera
    - Class: rviz/Select
  Value: true
Window Geometry:
  Height: 900
  Width: 1440
